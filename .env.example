# 复制为 .env 后填写：cp .env.example .env

# ── 大模型 ──
# 厂商特有的（调谁、在哪、怎么认证）：按下面出现的顺序找，第一家填了 API key 的生效；
# 选中之后这一组要填齐，缺了启动时会说缺哪个。代码里不藏默认值，都摆在这里自己填。

# 火山引擎方舟（coding plan 的 key 绑在 /api/coding 上，这条路只提供 Anthropic 协议）
ARK_API_KEY=
ARK_MODEL=glm-5.3-flash
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding

# Anthropic 官方（地址不用填，anthropic SDK 自带）
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# 通用的（怎么调）：换哪家都一样
LLM_TEMPERATURE=0
# LLM_TIMEOUT=180              # 可选，不填按 180 秒。带思考一次十几到一百多秒

# ── 数据源：Tushare Pro token（必填，P0 唯一数据源；部分接口有积分门槛）──
TUSHARE_TOKEN=
# 通过非官方地址（如第三方代理）接入时填写；为空则使用 Tushare 官方地址
# TUSHARE_HTTP_URL=

# 本地数据目录（行情数据与运行记录），默认 ./data
# LITMUS_DATA_DIR=./data

# ── 页面开关 ──
# 结果页显示「技术细节」：这次提问和运行的每一步调了什么、大模型原始返回是什么、各步耗时。
# 默认开（1）。填 0 只是页面不显示，过程记录照记，仍可 GET /api/traces/<编号> 取回——
# 想排查的那一次往往已经发生了，不能等打开开关才开始记
# LITMUS_SHOW_TRACE=1
