# 复制为 .env 后填写：cp .env.example .env

# ── LLM：Anthropic Messages 协议，base_url 可配（默认对接火山引擎 Anthropic 兼容端点）──
LLM_BASE_URL=https://<火山引擎端点>
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
# 认证头：auto（默认，api.anthropic.com 用 x-api-key，其余用 Bearer）/ bearer / x-api-key
# LLM_AUTH_STYLE=auto

# ── 数据源：Tushare Pro token（必填，P0 唯一数据源；部分接口有积分门槛）──
TUSHARE_TOKEN=
# 通过非官方地址（如第三方代理）接入时填写；为空则使用 Tushare 官方地址
# TUSHARE_HTTP_URL=

# 本地数据目录（行情数据与运行记录），默认 ./data
# LITMUS_DATA_DIR=./data

# ── 页面开关 ──
# 结果页显示「技术细节」：这次提问和运行的每一步调了什么、大模型原始返回是什么、各步耗时。
# 默认开（1）。填 0 只是页面不显示，过程记录照记，仍可 GET /api/traces/<编号> 取回——
# 想排查的那一次往往已经发生了，不能等打开开关才开始记
# LITMUS_SHOW_TRACE=1
